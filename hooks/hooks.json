{
  "hooks": [
    {
      "event": "user-prompt-submit",
      "description": "Bash scripting help - suggest fundamentals agent",
      "conditions": {
        "keywords": [
          "bash",
          "script",
          "shell",
          "variable",
          "function",
          "loop",
          "if",
          "case",
          "syntax",
          "shebang"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "01-bash-fundamentals",
          "message": "Need Bash help? The Bash Fundamentals agent can assist with scripts, variables, and control flow."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Text processing help - suggest text processing agent",
      "conditions": {
        "keywords": [
          "grep",
          "sed",
          "awk",
          "regex",
          "pattern",
          "search",
          "replace",
          "filter",
          "text",
          "parse"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "02-text-processing",
          "message": "Text processing task? The Text Processing agent specializes in grep, sed, awk, and regex."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "File operations help - suggest file operations agent",
      "conditions": {
        "keywords": [
          "chmod",
          "permission",
          "find",
          "tar",
          "archive",
          "zip",
          "rsync",
          "copy",
          "backup",
          "symlink"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "03-file-operations",
          "message": "File operation? The File Operations agent handles permissions, archives, and file management."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Process management help - suggest process agent",
      "conditions": {
        "keywords": [
          "process",
          "kill",
          "signal",
          "cron",
          "job",
          "background",
          "daemon",
          "ps",
          "top",
          "schedule"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "04-process-management",
          "message": "Process management? The Process agent handles jobs, signals, and scheduling."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Networking help - suggest networking agent",
      "conditions": {
        "keywords": [
          "curl",
          "ssh",
          "port",
          "network",
          "http",
          "api",
          "dns",
          "ping",
          "connection",
          "request"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "05-networking",
          "message": "Network task? The Networking agent specializes in curl, SSH, and network debugging."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Automation help - suggest automation agent",
      "conditions": {
        "keywords": [
          "automate",
          "ci",
          "cd",
          "deploy",
          "makefile",
          "github actions",
          "pipeline",
          "test",
          "bats"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "06-automation",
          "message": "Automation task? The Automation agent handles CI/CD, deployment, and testing."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Shell tools help - suggest tools agent",
      "conditions": {
        "keywords": [
          "jq",
          "json",
          "xargs",
          "parallel",
          "pipeline",
          "sort",
          "uniq",
          "cut",
          "column"
        ]
      },
      "actions": [
        {
          "type": "suggest-agent",
          "agent": "07-shell-tools",
          "message": "Data processing? The Shell Tools agent specializes in jq, xargs, and pipelines."
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Learning path planning",
      "conditions": {
        "keywords": [
          "learn bash",
          "learning path",
          "beginner",
          "intermediate",
          "advanced",
          "roadmap",
          "curriculum"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/my-learning-path",
          "message": "Get personalized Bash learning path: /my-learning-path bash --level beginner"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Skill assessment",
      "conditions": {
        "keywords": [
          "assess",
          "evaluate",
          "level",
          "proficiency",
          "how good",
          "where am i"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/skill-assessment",
          "message": "Assess your Bash skills: /skill-assessment bash"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Project ideas",
      "conditions": {
        "keywords": [
          "project",
          "build",
          "practice",
          "hands-on",
          "exercise",
          "portfolio"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/project-ideas",
          "message": "Get Bash project ideas: /project-ideas bash --level beginner"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Interview preparation",
      "conditions": {
        "keywords": [
          "interview",
          "prepare",
          "question",
          "devops interview",
          "shell interview"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/interview-prep",
          "message": "Prepare for shell scripting interviews: /interview-prep devops"
        }
      ]
    }
  ],
  "automation": {
    "enabled": true,
    "intelligence": "context-aware",
    "features": [
      "smart-keyword-detection",
      "contextual-agent-suggestions",
      "skill-level-adaptation"
    ]
  },
  "telemetry": {
    "enabled": false,
    "note": "Privacy-first: no tracking by default"
  }
}

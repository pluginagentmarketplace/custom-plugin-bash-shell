{
  "hooks": [
    {
      "event": "user-prompt-submit",
      "description": "Suggest commands when user mentions plugin development keywords",
      "conditions": {
        "keywords": [
          "plugin",
          "create",
          "scaffold",
          "develop",
          "build",
          "test",
          "validate",
          "deploy",
          "release",
          "bash",
          "automate"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/scaffold-plugin",
          "message": "Ready to create a new Claude Code plugin?"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Suggest validation when user talks about checking or validating",
      "conditions": {
        "keywords": [
          "validate",
          "check",
          "verify",
          "test",
          "ensure",
          "correct",
          "quality",
          "problem",
          "error",
          "issue"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/validate-plugin",
          "message": "Want to validate your plugin structure?"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Suggest testing when user mentions testing",
      "conditions": {
        "keywords": [
          "test",
          "testing",
          "test case",
          "coverage",
          "quality assurance",
          "qa",
          "verify"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/test-plugin",
          "message": "Run comprehensive tests on your plugin?"
        }
      ]
    },
    {
      "event": "user-prompt-submit",
      "description": "Suggest deployment when user mentions releasing or publishing",
      "conditions": {
        "keywords": [
          "deploy",
          "release",
          "publish",
          "submit",
          "marketplace",
          "launch",
          "go live",
          "version"
        ]
      },
      "actions": [
        {
          "type": "suggest-command",
          "command": "/deploy-plugin",
          "message": "Ready to deploy your plugin?"
        }
      ]
    },
    {
      "event": "command-execution",
      "description": "Suggest next steps after command execution",
      "actions": [
        {
          "type": "suggest-next-steps",
          "based-on": "command-type",
          "suggestions": {
            "scaffold-plugin": [
              "1. Edit agents in agents/ directory",
              "2. Create commands in commands/ directory",
              "3. Add skills in skills/ directory",
              "4. Run /validate-plugin to check structure",
              "5. Run /test-plugin to verify everything",
              "6. Use /deploy-plugin when ready"
            ],
            "validate-plugin": [
              "Review any errors reported",
              "Fix validation issues",
              "Run /validate-plugin again to confirm",
              "Once valid, proceed to /test-plugin"
            ],
            "test-plugin": [
              "All tests passed! 🎉",
              "Your plugin is quality-assured",
              "Ready to deploy with /deploy-plugin",
              "Or make more improvements"
            ],
            "deploy-plugin": [
              "✓ Plugin deployed successfully!",
              "Your plugin is now available",
              "Monitor for user feedback",
              "Plan next iteration"
            ]
          }
        }
      ]
    }
  ],
  "automation": {
    "enabled": true,
    "features": [
      "intelligent-command-suggestions",
      "workflow-guidance",
      "error-recovery",
      "progress-tracking"
    ]
  },
  "telemetry": {
    "enabled": true,
    "track": [
      "command-usage",
      "deployment-frequency",
      "plugin-quality-metrics",
      "user-preferences"
    ]
  }
}
